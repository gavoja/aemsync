{
  "name": "aemsync",
  "version": "5.2.4",
  "description": "The code and content synchronization for Sling / AEM (Adobe Experience Manager).",
  "author": "Michal Kochel",
  "type": "module",
  "keywords": [
    "Adobe",
    "AEM",
    "CQ",
    "Sling",
    "Synchronization"
  ],
  "homepage": "https://github.com/gavoja/aemsync",
  "bugs": {
    "url": "https://github.com/gavoja/aemsync/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gavoja/aemsync.git"
  },
  "main": "src/api.js",
  "devDependencies": {
    "dotenv": "^18.0.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.1",
    "fs-extra": "^11.3.1",
    "release-it": "^21.0.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "globrex": "^0.1.2",
    "lazy-eslint": "^0.2.1",
    "xml-to-json-stream": "^1.1.0"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.3"
    }
  },
  "scripts": {
    "start": "node ./src/cli.js",
    "lint": "npx eslint .",
    "format": "npx eslint . --fix",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --experimental-test-coverage --test-coverage-exclude \"test/**/*\"",
    "release": "dotenv run release-it -- --verbose",
    "release:ci": "dotenv run release-it --ci",
    "release:dry": "dotenv run release-it --dry-run"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "aemsync": "./src/cli.js"
  },
  "license": "MIT",
  "false": {}
}
